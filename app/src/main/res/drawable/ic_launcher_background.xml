<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!-- Flat Matte Hot Fuchsia (#FB24E1) to App Colors (#6366F1 / #2563EB) Gradient -->
  <path
      android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="12"
          android:startY="12"
          android:endX="96"
          android:endY="96"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFB24E1" />
        <item android:offset="0.35" android:color="#FFC026D3" />
        <item android:offset="0.70" android:color="#FF6366F1" />
        <item android:offset="1.0" android:color="#FF2563EB" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Ambient diffuse color orbs for depth without glossy specular reflection -->
  <path
      android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:centerX="32"
          android:centerY="30"
          android:gradientRadius="48"
          android:type="radial">
        <item android:offset="0.0" android:color="#33FB24E1" />
        <item android:offset="1.0" android:color="#00FB24E1" />
      </gradient>
    </aapt:attr>
  </path>
  <path
      android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:centerX="78"
          android:centerY="78"
          android:gradientRadius="48"
          android:type="radial">
        <item android:offset="0.0" android:color="#332563EB" />
        <item android:offset="1.0" android:color="#002563EB" />
      </gradient>
    </aapt:attr>
  </path>
</vector>
